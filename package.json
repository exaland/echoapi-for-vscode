    "file-saver": "^2.0.5",
    "graphql": "^16.9.0",
    "har2languages": "^0.0.5",
    "i18next": "^23.7.11",
    "i18next-browser-languagedetector": "^7.2.0",
    "iconv-lite": "^0.6.3",
    "immer": "^9.0.15",
    "js-yaml": "^4.1.0",

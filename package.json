{
  "name": "echoapi-for-vscode",
  "displayName": "EchoAPI for VS Code",
  "description": "Ultra-lightweight Rest API debugging tool for VS Code.",
  "version": "1.7.13",
  "publisher": "EchoAPI",
  "homepage": "https://www.echoapi.com",
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "NODE_ENV=development webpack",
    "watch": "webpack --mode development --watch",
    "package": "NODE_ENV=production webpack --mode production",
    "package:test": "NODE_ENV=development webpack --mode development",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "build": "vsce package",
    "start": "yarn compile && NODE_ENV=development webpack-dev-server --config scripts/start.js",
    "debug": "code --extensionDevelopmentPath=./path/to/your/extension"
  },
  "engines": {
    "vscode": "^1.74.3"
  },
  "keywords": [
    "rest client",
    "http client",
    "api client",
    "postman",
    "testing",
    "thunderclient",
    "thunder client",
    "restclient",
    "apiclient",
    "insomnia",
    "bruno",
    "api design",
    "api debbug",
    "api testing",
    "rest api",
    "websocket client",
    "socket.io client",
    "socket.io",
    "sse",
    "server sent events"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Testing"
  ],
  "icon": "dist/images/logo_icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "license": "MIT",
  "files": [
    "LICENSE.txt",
    "dist/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "sandbox": false,
  "contributes": {
    "configuration": {
      "title": "EchoAPI Settings",
      "properties": {
        "echoapi.documentServicePort": {
          "type": "number",
          "default": 3000,
          "description": "Default port number of the local document service"
        }
      }
    },
    "submenus": [
      {
        "id": "myView.commit",
        "label": "Commit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myExtension",
          "title": "EchoAPI for VS Code",
          "icon": "dist/images/logo.png"
        }
      ]
    },
    "views": {
      "myExtension": [
        {
          "id": "myView",
          "name": "EchoAPI for VS Code",
          "type": "webview",
          "icon": "dist/images/http.png"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "echoapi.login",
          "when": "view == myView",
          "group": "@1"
        },
        {
          "command": "echoapi.openEnv",
          "when": "view == myView",
          "group": "@2",
          "order": 1
        },
        {
          "command": "echoapi.openExtenisonSettings",
          "when": "view == myView",
          "group": "@2",
          "order": 2
        },
        {
          "command": "echoapi.openHelpDoc",
          "when": "view == myView",
          "group": "@3",
          "order": 100
        },
        {
          "command": "echoapi.feedBack",
          "when": "view == myView",
          "group": "@3",
          "order": 200
        }
      ]
    },
    "commands": [
      {
        "command": "echoapi.login",
        "title": "Manage Account"
      },
      {
        "command": "echoapi.openEnv",
        "title": "Environment"
      },
      {
        "command": "echoapi.openExtenisonSettings",
        "title": "Extension Settings"
      },
      {
        "command": "echoapi.feedBack",
        "title": "FeedBack",
        "category": "EchoAPI"
      },
      {
        "command": "echoapi.openHelpDoc",
        "title": "Help Docs",
        "category": "EchoAPI"
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.24.3",
    "@babel/plugin-transform-runtime": "^7.24.3",
    "@babel/preset-env": "^7.24.3",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@svgr/webpack": "^8.1.0",
    "@types/draft-js": "^0.11.17",
    "@types/file-saver": "^2.0.7",
    "@types/jsonpath": "^0.2.4",
    "@types/lodash": "^4.14.202",
    "@types/mocha": "^10.0.7",
    "@types/mockjs": "^1.0.10",
    "@types/node": "20.x",
    "@types/qs": "^6.9.11",
    "@types/react": "18.2.43",
    "@types/react-dom": "18.2.17",
    "@types/react-resizable": "^3.0.7",
    "@types/styled-components": "^5.1.34",
    "@types/url-parse": "^1.4.11",
    "@types/vscode": "^1.74.3",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "html-webpack-plugin": "^5.6.0",
    "less-loader": "^12.2.0",
    "node-polyfill-webpack-plugin": "^3.0.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "type-fest": "^4.8.3",
    "typescript": "^5.4.5",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^9.0.9",
    "@bytemd/plugin-breaks": "^1.21.0",
